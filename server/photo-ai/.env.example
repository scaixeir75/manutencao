# Segredos apenas no backend. Nunca publicar .env nem credenciais.
PHOTO_AI_ENABLED=false
NODE_ENV=production
# Produção exige zdr-verified; desenvolvimento admite limited-test-verified.
# Estes valores são declarações do operador após verificação, não ativam ZDR no fornecedor.
PHOTO_AI_RETENTION=unverified
PHOTO_AI_OBSERVABILITY=false
OPENAI_API_KEY=<INJECT_FROM_SECRET_MANAGER>
OPENAI_MODEL=<PMP_APPROVED_OPENAI_MODEL>
FIREBASE_PROJECT_ID=<PMP_GCP_PROJECT>
PHOTO_AI_ORIGINS=https://<PMP_PRODUCTION_ORIGIN>
PHOTO_AI_UIDS=<PMP_AUTHORIZED_UID_1>,<PMP_AUTHORIZED_UID_2>
REDIS_URL=<INJECT_FROM_SECRET_MANAGER>
PORT=8080
